{
  "name": "multi-region-mongo-patterns",
  "version": "1.0.0",
  "description": "MongoDB Atlas zone-sharding patterns for multi-region data residency: region-prefixed shard keys, zone-targeted reads, and nearest read preference. A patterns reference (zone routing activates on a real Atlas cluster).",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon -w src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "assets": "node scripts/make-readme-svg.mjs"
  },
  "keywords": [
    "mongodb",
    "zone-sharding",
    "data-residency",
    "multi-region",
    "gdpr",
    "backend",
    "typescript"
  ],
  "author": "Sudhanshu Singh",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "nodemon": "^3.1.14",
    "vitest": "^4.1.11"
  }
}
